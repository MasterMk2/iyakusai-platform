import assert from 'node:assert/strict';
import { mkdtempSync, mkdirSync, writeFileSync, rmSync } from 'node:fs';
import { tmpdir } from 'node:os';
import path from 'node:path';
import { pathToFileURL } from 'node:url';
import { chromium, expect } from '@playwright/test';
import { seedState, EDITOR_A } from '../helpers.js';
import { RED } from './helpers.js';
const root = path.resolve(import.meta.dirname, '../..'), output = path.join(root,'.tmp/workflow-qa');
const compiled = process.env.RENTAL_QA_COMPILED === '1';
const serverRoot = path.join(root, compiled ? 'dist/server' : 'src/server'), ext = compiled ? 'js' : 'ts';
const { StateStore } = await import(pathToFileURL(path.join(serverRoot,'domain/store.'+ext)).href);
const { buildApp, SESSION_COOKIE } = await import(pathToFileURL(path.join(serverRoot,'http/app.'+ext)).href);
const { RentalStore } = await import(pathToFileURL(path.join(serverRoot,'rental/store.'+ext)).href);
const { seedRentalDemo } = await import(pathToFileURL(path.join(serverRoot,'rental/seed.'+ext)).href);
mkdirSync(output,{recursive:true});
const dir = mkdtempSync(path.join(tmpdir(),'iyakusai-workflow-'));
if(!path.resolve(dir).startsWith(path.resolve(tmpdir())+path.sep))throw new Error('Unexpected temp path');
const rental = new RentalStore(dir,{demo:true}); seedRentalDemo(rental);
const actor = {id:EDITOR_A,name:'検証スタッフ'};
const group = rental.borrowerGroups().find(g=>g.name==='試用 模擬店A')!;
for (const [code,scope] of [['IY-100001','学外'],['IY-100002','学内'],['IY-100003','委員会']]) rental.preassign([{code,name:'検証用 '+scope,url:'https://example.invalid/i/'+code,borrower_id:group.id,item_scope:scope}],actor);
const app = await buildApp({store:new StateStore(await seedState(),null),listenPort:17849,rental:{store:rental,itemOrigin:null,webDir:path.join(root,compiled?'dist/rental-web':'src/rental-web')}});
await app.listen({host:'127.0.0.1',port:17849});
const browser = await chromium.launch({headless:true,channel:'msedge',args:['--use-fake-ui-for-media-stream','--use-fake-device-for-media-stream']});
const context = await browser.newContext({viewport:{width:1280,height:950},serviceWorkers:'block'});
await context.addCookies([{name:SESSION_COOKIE,value:EDITOR_A,url:'http://127.0.0.1:17849'}]);
const page = await context.newPage(), errors:string[] = [], checks:string[]=[];
page.on('pageerror',e=>errors.push(e.message));
async function read(code:string) { await page.locator('#item-code').fill(code); await page.locator('#item-form button').click(); await expect(page.locator('#current-code')).toContainText(code); }
async function next() { await page.locator('#workflow-next').click(); }
async function damage(value:string) { await page.locator('[data-damage="'+value+'"]').click(); await expect(page.locator('[data-damage="'+value+'"]')).toHaveAttribute('aria-pressed','true'); }
async function photo() { await page.locator('#photo-input').setInputFiles({name:'red.jpg',mimeType:'image/jpeg',buffer:RED}); await expect(page.locator('#photo-count')).toHaveText('1枚'); }
try {
  await page.goto('http://127.0.0.1:17849/rental');
  await page.locator('#item-code').fill('invalid'); await page.locator('#item-form button').click();
  await expect(page.locator('.identify #message')).toContainText('形式');
  checks.push('Read errors appear directly under the pressed reading controls');
  await read('IY-100001');
  await expect(page.locator('#item-summary-values')).toContainText('必須');
  await expect(page.locator('#photo-block')).toBeHidden();
  await next(); await expect(page.locator('#workflow-navigation #message')).toContainText('選んで');
  await damage('damage'); await next();
  await expect(page.locator('#photo-block')).toBeVisible();
  await next(); await expect(page.locator('#workflow-navigation #message')).toContainText('1枚以上');
  assert.equal(rental.item('IY-100001').status,'ready');
  checks.push('Explicit damage choice precedes photos; external photos cannot be skipped');
  await photo(); await next();
  await next(); await expect(page.locator('#workflow-navigation #message')).toContainText('メモ');
  await page.locator('#note').fill('貸出前から脚に傷');
  await next(); await expect(page.locator('#workflow-review-values')).toContainText('貸出前から脚に傷');
  await page.screenshot({path:path.join(output,'review-desktop.png'),fullPage:true});
  await next(); await expect(page.locator('#completion-title')).toContainText('貸出処理が完了');
  assert.equal(rental.item('IY-100001').status,'loaned');
  checks.push('Required damage notes, review and actual server-acknowledged loan completion');
  await page.locator('#completion-next').click(); await read('IY-100001');
  await expect(page.locator('#operation-choice')).toBeVisible();
  await expect(page.locator('#item-summary-values')).toContainText('貸出前から脚に傷');
  await expect(page.locator('#summary-loan-photos img')).toHaveCount(1);
  await page.locator('[data-choice="check"]').click();
  await expect(page.locator('#check-group-total')).toContainText('現在貸出中：1点');
  const baselineLoan = rental.item('IY-100001').current_loan;
  await damage('normal'); await next(); await photo(); await next();
  await page.locator('#note').fill('搬出前に確認'); await next(); await next();
  await expect(page.locator('#completion-title')).toContainText('チェック記録を保存');
  assert.deepEqual(rental.item('IY-100001').current_loan,baselineLoan);
  assert.equal(rental.summary().counts.loaned,1);
  assert.equal(rental.inspection('IY-100001').last_check!.note,'搬出前に確認');
  checks.push('Recorded checkpoint saves a photo and optional note while keeping loan, original condition and count');
  await page.locator('#completion-next').click(); await read('IY-100001');
  await expect(page.locator('#item-summary-values')).toContainText('搬出前に確認');
  await page.locator('[data-choice="return"]').click();
  await damage('normal'); await next(); await next(); await expect(page.locator('#workflow-navigation #message')).toContainText('1枚以上');
  await photo(); await next(); await next(); await next();
  await expect(page.locator('#completion-title')).toContainText('返却処理が完了');
  assert.equal(rental.item('IY-100001').status,'ready');
  checks.push('Return shows original loan damage and requires external photos even without new damage');
  await page.locator('#completion-next').click(); await read('IY-100002');
  await damage('normal'); await next(); await next(); await next();
  await next(); await expect(page.locator('#completion-title')).toContainText('貸出処理が完了');
  assert.equal(rental.item('IY-100002').status,'loaned');
  checks.push('Internal loan accepts zero photos and empty optional memo');
  await page.locator('#completion-next').click(); await read('IY-100002'); await page.locator('[data-choice="return"]').click();
  await damage('damage'); await next(); await next();
  await next(); await expect(page.locator('#workflow-navigation #message')).toContainText('メモ');
  await page.locator('#note').fill('戻った際に脚の曲がりあり');
  await expect(page.locator('#note-save-status')).toContainText('保存しました');
  await page.reload(); await expect(page.locator('#note')).toHaveValue('戻った際に脚の曲がりあり');
  await next(); await next(); await expect(page.locator('#completion-title')).toContainText('返却処理が完了');
  assert.equal(rental.item('IY-100002').status,'review');
  checks.push('Internal damaged return needs a memo, survives reload, accepts no photos, and becomes review');
  await page.locator('#completion-next').click(); await read('IY-100003');
  await page.setViewportSize({width:320,height:812});
  assert.equal(await page.evaluate('document.documentElement.scrollWidth <= window.innerWidth'),true);
  await page.screenshot({path:path.join(output,'condition-mobile-320.png'),fullPage:true});
  await page.locator('[data-damage="normal"]').focus(); await page.keyboard.press('Space');
  await expect(page.locator('[data-damage="normal"]')).toHaveAttribute('aria-pressed','true');
  await next(); await next(); await page.locator('#note').fill('未送信テスト'); await next();
  await page.route('**/api/rental/operations',r=>r.abort());
  await next(); await expect(page.locator('#completion-status')).toContainText('端末に保持');
  assert.equal(rental.item('IY-100003').status,'ready');
  await page.screenshot({path:path.join(output,'pending-mobile-320.png'),fullPage:true});
  await page.unroute('**/api/rental/operations');
  await page.locator('#resend').click(); await expect(page.locator('#completion-title')).toContainText('貸出処理が完了');
  checks.push('320px has no overflow, keyboard choices work, network errors retain inputs and retry exactly once');
  await page.locator('#completion-next').click(); await read('IY-100003'); await page.locator('[data-choice="check"]').click();
  await damage('damage'); await next(); await next(); await page.locator('#note').fill('委員会物品のチェックで傷を確認'); await next();
  const prior = rental.item('IY-100003');
  await rental.submit({operation_id:crypto.randomUUID(),item_code:'IY-100003',item_version:prior.version,action:'check',borrower:'',condition:'normal',note:'別スタッフの先行チェック',client_at:new Date().toISOString(),client_read_at:new Date().toISOString()},[],actor);
  await next(); await expect(page.locator('#completion-status')).toContainText('更新されています');
  assert.equal(rental.item('IY-100003').status,'loaned');
  assert.equal(rental.inspection('IY-100003').last_check!.note,'別スタッフの先行チェック');
  checks.push('Concurrent checkpoint rejects the stale operation and retains its draft rather than overwriting');
  await page.evaluate('openItem("IY-100003",false,"check")');
  await expect(page.locator('.identify #message')).toContainText('確認待ち');
  await expect(page.locator('#item-panel')).toBeHidden();
  checks.push('Explicit checkpoint entry also blocks unresolved operations with visible feedback near reading');
  await page.locator('#completion-next').click(); await read('IY-100003');
  await expect(page.locator('.identify #message')).toContainText('未送信または確認待ち');
  assert.equal(await page.evaluate('state.draft === null'),true);
  checks.push('A pending/conflicting checkpoint cannot open a second registration of the same item');
  await read('IY-100002');
  await expect(page.locator('#workflow-title')).toContainText('チェック');
  await damage('normal');
  await page.evaluate('openPCRead({url:"https://app.iyakusai.com/i/IY-100001"})');
  await expect(page.locator('#current-code')).toContainText('IY-100002');
  await expect(page.locator('#message')).toContainText('入力中の物品');
  assert.equal(await page.evaluate('state.draft.damageSelected'),true);
  checks.push('A checkpoint with a selected condition cannot be replaced by another PC card');
  await next(); await next(); await next(); await next();
  await expect(page.locator('#completion-title')).toContainText('チェック記録を保存');
  assert.equal(rental.item('IY-100002').status,'review');
  assert.equal(rental.item('IY-100002').current_loan,null);
  checks.push('A review item can save a checkpoint while preserving its review state');
  rental.preassign([{code:'IY-100004',name:'読取検証用',url:'https://app.iyakusai.com/i/IY-100004',borrower_id:group.id,item_scope:'学内'}],actor);
  rental.submit({operation_id:crypto.randomUUID(),item_code:'IY-100004',item_version:rental.item('IY-100004').version,action:'borrow',borrower:'試用 模擬店A',condition:'normal',note:'',client_at:new Date().toISOString(),client_read_at:new Date().toISOString()},[],actor);
  await page.locator('#completion-next').click();
  await page.evaluate('window.NDEFReader=class {async scan(){window.__testNFCReader=this}}; startNFC()');
  const nfcRead = async (code:string) => { await expect.poll(()=>page.evaluate('!lockedDraft()')).toBe(true); await page.evaluate(`window.__testNFCReader.onreading({message:{records:[{recordType:"url",encoding:"utf-8",data:new TextEncoder().encode("https://app.iyakusai.com/i/${code}")}]}})`); await expect(page.locator('#current-code')).toContainText(code); await expect.poll(()=>page.evaluate('!lockedDraft()')).toBe(true); };
  const close = async () => {await page.locator('#skip-item').click();await expect(page.locator('#item-panel')).toBeHidden();await expect.poll(()=>page.evaluate('!lockedDraft()')).toBe(true);};
  await nfcRead('IY-100001'); assert.equal(await page.evaluate('state.config.mode'),'borrow'); await close();
  await nfcRead('IY-100004'); await expect(page.locator('#operation-choice')).toBeVisible(); await close(); await page.evaluate('stopNFC()');
  checks.push('Simulated Web NFC reads select loan for ready items and choices for loaned items');
  await page.evaluate('openPCRead({url:"https://app.iyakusai.com/i/IY-100001"})'); assert.equal(await page.evaluate('state.config.mode'),'borrow'); await close();
  await page.evaluate('openPCRead({url:"https://app.iyakusai.com/i/IY-100004"})'); await expect(page.locator('#operation-choice')).toBeVisible(); await close();
  checks.push('Simulated PC reader cards use the same ready/loaned operation choices');
  for (const [code,expected] of [['IY-100001','borrow'],['IY-100004','choose']]) {
    await page.evaluate(`state.detector={detect:async()=>[{rawValue:"https://app.iyakusai.com/i/${code}"}]}`);
    await page.locator('#scan-qr').click(); await expect(page.locator('#current-code')).toContainText(code); await expect.poll(()=>page.evaluate('state.config.mode')).toBe(expected);
    await page.evaluate('stopCamera()');
    if(expected==='choose'){await page.locator('#item-panel').screenshot({path:path.join(output,'choice-integrated.png')});}
    await close();
  }
  checks.push('Simulated QR camera reads preserve automatic loan/choice behavior in the staged workflow');
  assert.deepEqual(errors,[]);
  writeFileSync(path.join(output,compiled?'compiled-verification.json':'verification.json'),JSON.stringify({passed:true,compiledRuntime:compiled,checks,browserErrors:errors,syntheticOnly:true,realHardwareTested:false},null,2));
  console.log(JSON.stringify({passed:true,checks:checks.length,output}));
} finally { await browser.close(); await app.close(); rental.close(); rmSync(dir,{recursive:true,force:true}); }

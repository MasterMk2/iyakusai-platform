import assert from 'node:assert/strict';
import { mkdtempSync, mkdirSync, writeFileSync, rmSync } from 'node:fs';
import { tmpdir } from 'node:os';
import path from 'node:path';
import { chromium, expect } from '@playwright/test';
import { StateStore } from '../../src/server/domain/store.js';
import { buildApp, SESSION_COOKIE } from '../../src/server/http/app.js';
import { seedRentalDemo } from '../../src/server/rental/seed.js';
import { RentalStore } from '../../src/server/rental/store.js';
import { seedState, EDITOR_A } from '../helpers.js';
import { metadata, RED, BLUE } from './helpers.js';

// Real HTTP and browser, synthetic loans only; scanner callbacks simulate a card read.
const root = path.resolve(import.meta.dirname, '../..');
const output = path.join(root, '.tmp/inspection-qa');
mkdirSync(output, { recursive: true });
const dir = mkdtempSync(path.join(tmpdir(), 'iyakusai-inspection-browser-'));
assert.ok(path.resolve(dir).startsWith(path.resolve(tmpdir()) + path.sep), 'Unexpected synthetic test directory');
const rental = new RentalStore(dir, { demo: true });
seedRentalDemo(rental);
rental.addItems([['IY-100001', '椅子'], ['IY-100002', '椅子']]);
const actor = { id: EDITOR_A, name: '検品用スタッフ' };
const initial = metadata({ condition: 'damage', note: '貸出前から脚に傷。付属ケーブル2本。' });
rental.submit(initial, [RED, BLUE], actor);
for (const code of ['IY-100001', 'IY-100002']) rental.submit(metadata({ item_code: code, photo_skip: true }), [], actor);
const before = rental.overview().items;
const app = await buildApp({ store: new StateStore(await seedState(), null), listenPort: 17719, rental: { store: rental, itemOrigin: null, webDir: path.join(root, 'src/rental-web') } });
await app.listen({ host: '127.0.0.1', port: 17719 });
const browser = await chromium.launch({ headless: true, channel: 'msedge' });
const context = await browser.newContext({ viewport: { width: 1280, height: 900 }, serviceWorkers: 'block' });
await context.addCookies([{ name: SESSION_COOKIE, value: EDITOR_A, url: 'http://127.0.0.1:17719' }]);
const page = await context.newPage();
const errors: string[] = [];
const writes: string[] = [];
page.on('pageerror', (error) => errors.push(error.message));
page.on('request', (request) => { if (request.url().includes('/api/rental/') && request.method() !== 'GET') writes.push(`${request.method()} ${request.url()}`); });
const checks: string[] = [];
try {
  await page.goto('http://127.0.0.1:17719/rental');
  await page.locator('[data-mode="check"]').click();
  await page.locator('#item-code').fill('IY-000123');
  await page.locator('#item-form button').click();
  await expect(page.locator('#check-loan-state')).toContainText('貸出時から損傷あり');
  await expect(page.locator('#check-loan-note')).toContainText('付属ケーブル2本');
  await expect(page.locator('#check-group-total')).toContainText('現在貸出中：3点');
  await expect(page.locator('#check-photos img')).toHaveCount(2);
  await expect.poll(() => page.locator('#check-photos img').evaluateAll((images) => images.every((image) => (image as HTMLImageElement).naturalWidth > 0))).toBe(true);
  for (const id of ['return-options', 'photo-block', 'lend-condition', 'note', 'queue-item', 'commit-hint']) await expect(page.locator(`#${id}`)).toBeHidden();
  await page.locator('.check-inventory-row summary').filter({ hasText: '椅子' }).click();
  await expect(page.getByRole('button', { name: 'No.1', exact: true })).toBeVisible();
  await expect(page.getByRole('button', { name: 'No.2', exact: true })).toBeVisible();
  checks.push('Actual HTTP: loan damage, note, two authenticated photos, group totals and individual numbers');
  await page.evaluate('commitItem("normal")');
  assert.deepEqual(rental.overview().items, before);
  assert.equal(writes.length, 0);
  checks.push('Calling registration while checking creates no API write and changes no item/version/history');
  await page.locator('#inspection-panel').screenshot({ path: path.join(output, 'desktop.png') });
  await page.setViewportSize({ width: 320, height: 812 });
  assert.equal(await page.evaluate('document.documentElement.scrollWidth <= window.innerWidth'), true);
  await page.evaluate('window.scrollTo(0, 0)');
  await page.screenshot({ path: path.join(output, 'mobile-320.png'), fullPage: true });
  checks.push('320px phone: no horizontal overflow, readable photos and quantity details');
  await page.getByRole('button', { name: 'No.1', exact: true }).click();
  await expect(page.locator('#item-title')).toHaveText('椅子');
  await expect(page.locator('#check-photo-hint')).toHaveText('貸出時は写真を省略しています。');
  await page.evaluate('openPCRead({url:"https://example.invalid/i/IY-100002"})');
  await expect(page.locator('#current-code')).toContainText('No.2');
  await expect(page.locator('#check-group-total')).toContainText('現在貸出中：3点');
  checks.push('Simulated PC card callback replaces inspected item without closing or registering');
  await page.reload();
  await expect(page.locator('[data-mode="check"]')).toHaveAttribute('aria-pressed', 'true');
  await expect(page.locator('#current-code')).toContainText('No.2');
  checks.push('Reload preserves check mode and refreshes the selected item');
  await page.route('**/api/rental/items/*/inspection', (route) => route.abort());
  await page.locator('#check-refresh').click();
  await expect(page.locator('#check-updated')).toContainText('現在の状態は未確認');
  await expect(page.locator('#check-group-total')).toContainText('3点');
  checks.push('Network failure identifies cached quantities and the unverified current state');
  await page.unroute('**/api/rental/items/*/inspection');
  await page.locator('#check-refresh').click();
  await expect(page.locator('#check-updated')).toContainText('サーバーの状態');
  await page.locator('#edit-batch').click();
  await page.locator('[data-mode="return"]').click();
  await expect(page.locator('#return-normal')).toBeVisible();
  await expect(page.locator('#inspection-panel')).toBeHidden();
  await page.locator('#edit-batch').click();
  await page.locator('[data-mode="borrow"]').click();
  await page.locator('#note').fill('未登録のメモ');
  await page.locator('[data-mode="check"]').click();
  await expect(page.locator('#message')).toContainText('入力中の写真・メモ');
  await expect(page.locator('[data-mode="borrow"]')).toHaveAttribute('aria-pressed', 'true');
  checks.push('Explicit return switching opens return controls; unfinished loan notes block mode changes');
  assert.equal(writes.length, 0);
  assert.deepEqual(rental.overview().items, before);
  assert.deepEqual(errors, []);
  writeFileSync(path.join(output, 'browser-verification.json'), JSON.stringify({ passed: true, checks, apiWrites: writes, browserErrors: errors, syntheticDataOnly: true, realHardwareTested: false }, null, 2));
  console.log(JSON.stringify({ passed: true, checks: checks.length, apiWrites: writes.length, browserErrors: errors.length, output }));
} finally {
  await browser.close(); await app.close(); rental.close();
  rmSync(dir, { recursive: true, force: true });
}

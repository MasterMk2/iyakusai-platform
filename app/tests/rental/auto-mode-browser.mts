import assert from 'node:assert/strict';
import { mkdirSync, mkdtempSync, writeFileSync } from 'node:fs';
import path from 'node:path';
import { chromium, expect } from '@playwright/test';
import { StateStore } from '../../src/server/domain/store.js';
import { buildApp, SESSION_COOKIE } from '../../src/server/http/app.js';
import { seedRentalDemo } from '../../src/server/rental/seed.js';
import { RentalStore } from '../../src/server/rental/store.js';
import { seedState, EDITOR_A } from '../helpers.js';
import { metadata, RED, BLUE } from './helpers.js';

// Loopback HTTP + real SQLite + Edge; only the NFC/PC/QR input devices are simulated.
const root = path.resolve(import.meta.dirname, '../..');
const output = path.join(root, '.tmp/auto-mode-qa');
mkdirSync(output, { recursive: true });
const rental = new RentalStore(mkdtempSync(path.join(output, 'synthetic-ledger-')), { demo: true });
seedRentalDemo(rental);
for (let n = 1; n <= 9; n++) rental.addItems([[`IY-${100000 + n}`, n <= 2 ? '椅子' : '折りたたみ机']]);
const actor = { id: EDITOR_A, name: '検品用スタッフ' };
for (const n of [1, 2, 6, 9]) rental.submit(metadata({ item_code: `IY-${100000 + n}`, ...(n === 1 ? { condition: 'damage', note: '貸出前から脚に傷。' } : { photo_skip: true }) }), n === 1 ? [RED, BLUE] : [], actor);
rental.submit(metadata({ item_code: 'IY-100005', photo_skip: true }), [], actor);
rental.submit(metadata({ item_code: 'IY-100005', item_version: 1, action: 'return', borrower: '', condition: 'damage', note: '脚が破損' }), [RED], actor);
const initial = rental.overview().items;
const app = await buildApp({ store: new StateStore(await seedState(), null), listenPort: 17839, rental: { store: rental, itemOrigin: null, webDir: path.join(root, 'src/rental-web') } });
await app.listen({ host: '127.0.0.1', port: 17839 });
const origin = 'http://127.0.0.1:17839';
const browser = await chromium.launch({ headless: true, channel: 'msedge', args: ['--use-fake-ui-for-media-stream', '--use-fake-device-for-media-stream'] });
const context = await browser.newContext({ viewport: { width: 1280, height: 900 }, serviceWorkers: 'block' });
await context.addCookies([{ name: SESSION_COOKIE, value: EDITOR_A, url: origin }]);
await context.addInitScript({ content: 'window.NDEFReader = class { async scan() { window.__testNFCReader = this; } };' });
const page = await context.newPage();
const errors: string[] = [];
const writes: string[] = [];
page.on('pageerror', (error) => errors.push(error.message));
page.on('request', (r) => { if (r.url().includes('/api/rental/') && r.method() !== 'GET') writes.push(`${r.method()} ${r.url()}`); });
const checks: string[] = [];
const mode = () => page.evaluate('state.config.mode');
const pcRead = async (n: number) => { await expect.poll(() => page.evaluate('!lockedDraft()')).toBe(true); await page.evaluate(`openPCRead({url:"https://app.iyakusai.com/i/IY-${100000 + n}"})`); };
const close = async () => { await expect.poll(() => page.evaluate('!lockedDraft()')).toBe(true); await page.locator('#skip-item').click(); await expect(page.locator('#item-panel')).toBeHidden(); await expect.poll(() => page.evaluate('!lockedDraft()')).toBe(true); };
const open = async (n: number) => { await page.locator('#item-code').fill(String(n)); await page.locator('#item-form button').click(); await expect(page.locator('#item-panel')).toBeVisible(); await expect(page.locator('#current-code')).toContainText(`No.${n}`); await expect.poll(() => page.evaluate('!lockedDraft()')).toBe(true); };
try {
  await page.goto(`${origin}/rental`);
  await expect(page.locator('#workspace')).toBeVisible();
  await open(1);
  await expect(page.locator('#operation-choice')).toBeVisible();
  assert.equal(await mode(), 'choose');
  for (const id of ['return-options', 'inspection-panel', 'photo-block', 'note', 'lend-condition', 'queue-item', 'commit-hint']) await expect(page.locator(`#${id}`)).toBeHidden();
  await page.evaluate('commitItem("normal")');
  assert.equal(writes.length, 0); assert.deepEqual(rental.overview().items, initial);
  checks.push('A loaned manual read requires a choice and cannot register before selection');
  await page.locator('#item-panel').screenshot({ path: path.join(output, 'choice-desktop.png') });
  await page.setViewportSize({ width: 320, height: 812 });
  assert.equal(await page.evaluate('document.documentElement.scrollWidth <= innerWidth'), true);
  assert.equal(await page.locator('[data-choice="return"]').evaluate((el) => el.getBoundingClientRect().height >= 46), true);
  await page.screenshot({ path: path.join(output, 'choice-mobile-320.png'), fullPage: true });
  await page.keyboard.press('Tab');
  await expect(page.locator('[data-choice="return"]')).toBeFocused();
  await page.keyboard.press('Enter');
  await expect(page.locator('#return-normal')).toBeVisible();
  assert.equal(await mode(), 'return'); assert.equal(writes.length, 0); assert.deepEqual(rental.overview().items, initial);
  checks.push('320px choice fits, has large buttons, and keyboard selection creates no write');
  await page.reload();
  await expect(page.locator('#return-normal')).toBeVisible();
  assert.equal(await mode(), 'return');
  checks.push('Reload preserves a deliberately selected return and its item');
  await page.locator('#return-normal').click();
  await expect.poll(() => rental.item('IY-100001').status).toBe('ready');
  await expect.poll(() => page.evaluate('state.queue.every(op => op.acknowledged)')).toBe(true);
  assert.equal(writes.length, 1);
  checks.push('A return is registered only by pressing its registration button');
  await pcRead(1);
  await expect(page.locator('[data-mode="borrow"]')).toHaveAttribute('aria-pressed', 'true');
  await expect(page.locator('#queue-item')).toBeVisible();
  assert.equal(await mode(), 'borrow');
  checks.push('A PC read of the returned/ready item automatically changes return to loan');
  await page.locator('#edit-batch').click();
  await page.locator('#borrower').fill('試用 模擬店A');
  await page.locator('#photo-skip').check();
  await page.locator('#queue-item').click();
  await expect.poll(() => rental.item('IY-100001').status).toBe('loaned');
  await expect.poll(() => page.evaluate('state.queue.every(op => op.acknowledged)')).toBe(true);
  assert.equal(writes.length, 2);
  checks.push('Automatic loan mode preserves borrower selection and photo-skip registration');
  await pcRead(2);
  await expect(page.locator('#operation-choice')).toBeVisible();
  await page.reload();
  await expect(page.locator('#operation-choice')).toBeVisible();
  assert.equal(await mode(), 'choose');
  checks.push('The next loaned card asks again, and a pending choice survives reload');
  await page.locator('[data-choice="check"]').click();
  await expect(page.locator('#inspection-panel')).toBeVisible();
  await expect(page.locator('#check-group-total')).toContainText('4点');
  assert.equal(writes.length, 2);
  await page.reload();
  await expect(page.locator('#inspection-panel')).toBeVisible();
  assert.equal(await mode(), 'check');
  await pcRead(1);
  await expect(page.locator('#operation-choice')).toBeVisible();
  assert.equal(await mode(), 'choose');
  checks.push('Inspection reads quantities without writes, reload keeps it, and a new loaned card asks again');
  await page.locator('[data-choice="check"]').click();
  await expect(page.locator('#inspection-panel')).toBeVisible();
  await pcRead(3);
  await expect(page.locator('#current-code')).toContainText('No.3');
  assert.equal(await mode(), 'borrow');
  checks.push('A ready card automatically changes inspection to loan');
  await page.locator('#note').fill('未登録のメモを保持');
  await page.locator('#photo-input').setInputFiles({ name: 'proof.jpg', mimeType: 'image/jpeg', buffer: RED });
  await expect(page.locator('#photo-count')).toHaveText('1枚');
  await pcRead(2);
  await expect(page.locator('#message')).toContainText('入力中の物品');
  await page.locator('#edit-batch').click();
  await page.locator('[data-mode="check"]').click();
  await expect(page.locator('#message')).toContainText('入力中の写真・メモ');
  await page.reload();
  await expect(page.locator('#note')).toHaveValue('未登録のメモを保持');
  await expect(page.locator('#photo-count')).toHaveText('1枚');
  assert.equal(await mode(), 'borrow');
  assert.equal(writes.length, 2);
  checks.push('An unfinished loan keeps its item, note and photo across new reads, mode changes and reload');
  page.once('dialog', (dialog) => dialog.accept()); await close();
  await open(5);
  await expect(page.locator('#inspection-panel')).toBeVisible();
  assert.equal(await mode(), 'check');
  await expect(page.locator('#item-state')).toContainText('要確認');
  await page.evaluate('commitItem("normal")');
  assert.equal(writes.length, 2);
  checks.push('A returned item with damage opens inspection and never offers a new loan');
  await pcRead(2);
  await expect(page.locator('#operation-choice')).toBeVisible();
  await page.route('**/api/rental/items/IY-100002/inspection', (route) => route.abort());
  await page.locator('[data-choice="check"]').click();
  // This item was already inspected, so the cached inspection is allowed with a visible stale-data label.
  await expect(page.locator('#inspection-panel')).toBeVisible();
  await expect(page.locator('#check-updated')).toContainText('現在の状態は未確認');
  await expect(page.locator('#message')).toContainText('保存済み情報');
  await page.unroute('**/api/rental/items/IY-100002/inspection');
  await page.locator('#check-refresh').click();
  await expect(page.locator('#check-updated')).toContainText('サーバーの状態');
  checks.push('Cached inspection is visibly stale, and refresh restores the latest server data');
  await pcRead(9);
  await expect(page.locator('#operation-choice')).toBeVisible();
  await page.route('**/api/rental/items/IY-100009/inspection', (route) => route.abort());
  await page.locator('[data-choice="check"]').click();
  await expect(page.locator('#operation-choice')).toBeVisible();
  assert.equal(await mode(), 'choose');
  await expect(page.locator('#message')).toContainText('チェック情報は端末に保存されていません');
  await page.unroute('**/api/rental/items/IY-100009/inspection');
  checks.push('An inspection fetch failure without a cache preserves the pending choice');
  await close(); await open(7); await close();
  await page.route('**/api/rental/items/IY-100007', (route) => route.abort());
  await open(7); assert.equal(await mode(), 'borrow');
  await expect(page.locator('#message')).toContainText('以前の状態');
  await page.unroute('**/api/rental/items/IY-100007');
  await close(); await pcRead(2); await close();
  await page.route('**/api/rental/items/IY-100002', (route) => route.abort());
  await open(2); await expect(page.locator('#operation-choice')).toBeVisible();
  await expect(page.locator('#message')).toContainText('以前の状態');
  await page.unroute('**/api/rental/items/IY-100002');
  checks.push('Offline ready/loaned reads follow their cached state and clearly mark it as old');
  await close(); await open(6); await page.locator('[data-choice="return"]').click();
  rental.submit(metadata({ item_code: 'IY-100006', item_version: 1, action: 'return', borrower: '' }), [], actor);
  await page.locator('#return-normal').click();
  await expect.poll(() => page.evaluate('state.queue.some(op => op.meta.item_code === "IY-100006" && op.status === "conflict")')).toBe(true);
  const afterConflict = rental.item('IY-100006');
  assert.equal(afterConflict.status, 'ready'); assert.equal(afterConflict.version, 2);
  await page.locator('#edit-batch').click(); await page.locator('[data-mode="check"]').click();
  await pcRead(6);
  await expect(page.locator('#message')).toContainText('未送信または確認待ち');
  assert.equal(await page.evaluate('state.draft === null'), true);
  checks.push('Concurrent returns are rejected by the server and a pending/conflicting operation cannot be bypassed from inspection');
  await page.locator('#scan-nfc').click();
  await page.evaluate('window.__testNFCReader.onreading({message:{records:[{recordType:"url",encoding:"utf-8",data:new TextEncoder().encode("https://app.iyakusai.com/i/IY-100004")}]}})');
  await expect(page.locator('#current-code')).toContainText('No.4'); assert.equal(await mode(), 'borrow');
  await close();
  await page.evaluate('window.__testNFCReader.onreading({message:{records:[{recordType:"url",encoding:"utf-8",data:new TextEncoder().encode("https://app.iyakusai.com/i/IY-100002")}]}})');
  await expect(page.locator('#operation-choice')).toBeVisible();
  checks.push('Web NFC events use the same automatic ready/loaned decisions');
  await close(); await page.evaluate('stopNFC()');
  await page.setViewportSize({ width: 1280, height: 900 });
  await page.evaluate('state.detector = {detect: async () => [{rawValue:"https://app.iyakusai.com/i/IY-100002"}]}');
  await page.locator('#scan-qr').click();
  await expect(page.locator('#operation-choice')).toBeVisible();
  await page.evaluate('stopCamera()'); await close();
  await page.evaluate('state.detector = {detect: async () => [{rawValue:"https://app.iyakusai.com/i/IY-100004"}]}');
  await page.locator('#scan-qr').click();
  await expect(page.locator('#current-code')).toContainText('No.4'); assert.equal(await mode(), 'borrow');
  await page.evaluate('stopCamera()');
  checks.push('QR camera scanner callbacks use the same automatic loan/choice decisions');
  await close();
  await page.goto(`${origin}/i/IY-100002`);
  await expect(page.locator('#operation-choice')).toBeVisible();
  checks.push('A phone/card item URL opens the loaned choice as well');
  const beforeStorageFailure = await page.evaluate('({mode:state.config.mode,code:state.draft.item.code})');
  await page.evaluate('window.__saveSelection = saveSelection; saveSelection = async () => {throw new Error("simulated quota failure")};');
  await page.locator('[data-choice="return"]').click();
  await expect(page.locator('#message')).toContainText('設定を保存できません');
  assert.deepEqual(await page.evaluate('({mode:state.config.mode,code:state.draft.item.code})'), beforeStorageFailure);
  await page.evaluate('saveSelection = window.__saveSelection');
  checks.push('A device storage failure does not silently change the pending mode or item');
  assert.deepEqual(errors, []);
  const result = { passed: true, checks, browserErrors: errors, clientRegistrations: writes.length, syntheticDataOnly: true, realHardwareTested: false, productionChanged: false };
  writeFileSync(path.join(output, 'browser-verification.json'), JSON.stringify(result, null, 2));
  console.log(JSON.stringify({ passed: true, checks: checks.length, clientRegistrations: writes.length, output }));
} catch (error) {
  writeFileSync(path.join(output, 'last-failure.json'), JSON.stringify({ checks, browserErrors: errors, error: String(error) }, null, 2));
  throw error;
} finally {
  await browser.close(); await app.close(); rental.close();
}

// The emulator and page.evaluate hand back loosely shaped JSON that this check script only records.
/* eslint-disable @typescript-eslint/no-explicit-any */
import assert from 'node:assert/strict';
import {mkdirSync,writeFileSync} from 'node:fs';
import path from 'node:path';
import {spawn} from 'node:child_process';
import {chromium,expect} from '@playwright/test';
import {seedState,EDITOR_A} from '../helpers.js';
import {RED} from './helpers.js';
import {StateStore} from '../../dist/server/domain/store.js';
import {buildApp,SESSION_COOKIE} from '../../dist/server/http/app.js';
import {RentalStore} from '../../dist/server/rental/store.js';
import {seedRentalDemo} from '../../dist/server/rental/seed.js';
const root=path.resolve(import.meta.dirname,'../..'),out=path.resolve(root,process.env.UX_ACCEPT_OUT||'../evidence/acceptance-final');mkdirSync(out,{recursive:true});
const origin='http://127.0.0.1:17793',panelOrigin='http://127.0.0.1:48744';
const rental=new RentalStore(path.join(out,'ledger'),{demo:true});seedRentalDemo(rental);
const actor={id:EDITOR_A,name:'UX改良検証'},group=rental.borrowerGroups().find(g=>g.name==='試用 模擬店A')!;
for(let i=1;i<=24;i++)rental.preassign([{code:`IY-${100000+i}`,name:'UX検証 '+i,url:`https://app.iyakusai.com/i/IY-${100000+i}`,borrower_id:group.id,item_scope:[3,7,8].includes(i)?'学外':i===24?'委員会':'学内'}],actor);
const app=await buildApp({store:new StateStore(await seedState(),null),listenPort:17793,rental:{store:rental,itemOrigin:null,webDir:path.join(root,'dist/rental-web')}});
app.addHook('onSend',async(req,reply,payload)=>{const csp=reply.getHeader('Content-Security-Policy');if(csp)reply.header('Content-Security-Policy',String(csp).replaceAll('http://127.0.0.1:48731','http://127.0.0.1:48743'));if(req.url.split('?')[0]==='/rental/app.js'&&typeof payload==='string')return payload.replace("const PC_READER = 'http://127.0.0.1:48731';","const PC_READER = 'http://127.0.0.1:48743';");return payload;});
await app.listen({host:'127.0.0.1',port:17793});
const python=path.join(process.env.USERPROFILE!,'.cache/codex-runtimes/codex-primary-runtime/dependencies/python/python.exe');
const emu=spawn(python,['-u',path.resolve(root,'../emulator/emulator.py'),'--port','48743','--control-port','48744','--app-origin',origin],{windowsHide:true,env:{...process.env,PYTHONUTF8:'1'},stdio:['ignore','pipe','pipe']});
let trace='';emu.stdout.on('data',b=>trace+=b);emu.stderr.on('data',b=>trace+=b);
const pause=(ms:number)=>new Promise(r=>setTimeout(r,ms));
async function until(fn:()=>Promise<boolean>|boolean,label:string,ms=7000){const end=Date.now()+ms;while(Date.now()<end){if(await fn())return;await pause(25);}throw Error(label);}
await until(()=>{if(emu.exitCode!==null)throw Error(trace);return trace.includes('48744')},'emulator');
const browser=await chromium.launch({headless:true,channel:'msedge'}),ctx=await browser.newContext({viewport:{width:1280,height:950},serviceWorkers:'block'});
const errors:string[]=[],external:string[]=[],results:any[]=[];
await ctx.route('**/*',async route=>{const url=new URL(route.request().url());if(!['127.0.0.1','localhost'].includes(url.hostname)){external.push(url.href);await route.abort();}else if(url.pathname==='/rental/app.js'){const response=await route.fetch();const body=(await response.text()).replace("const PC_READER = 'http://127.0.0.1:48731';","const PC_READER = 'http://127.0.0.1:48743';");await route.fulfill({response,body});}else await route.continue();});
await ctx.addCookies([{name:SESSION_COOKIE,value:EDITOR_A,url:origin}]);
const panel=await ctx.newPage();await panel.goto(panelOrigin);
const control=(action:string,data:any={})=>panel.evaluate(async({action,data})=>{const res=await fetch('/control/'+action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const body=await res.json();if(!res.ok)throw Error(body.error);return body},{action,data});
const snapshot=()=>panel.evaluate(async()=>await(await fetch('/control/state')).json());
const page=await ctx.newPage();page.on('pageerror',e=>errors.push(e.message));page.on('dialog',d=>d.accept());
await page.goto(origin+'/rental');await expect(page.locator('#workspace')).toBeVisible();await page.locator('#scan-pc').click();await expect(page.locator('#reader-status')).toContainText('カードを置');
async function tap(code:string){await control('remove');await control('place',{code});}
async function read(code:string){await tap(code);await expect(page.locator('#current-code')).toContainText(code);await expect(page.locator('#item-loading')).toBeHidden();}
async function clear(){if(await page.locator('#item-panel').isVisible())await page.locator('#skip-item').click();if(await page.locator('#workflow-completion').isVisible())await page.locator('#completion-next').click();await control('remove');}
const next=()=>page.locator('#workflow-next').click();
const normal=()=>page.locator('[data-damage="normal"]').click();
const photo=()=>page.locator('#photo-input').setInputFiles({name:'test.jpg',mimeType:'image/jpeg',buffer:RED});
const shot=(name:string)=>page.screenshot({path:path.join(out,name+'.png'),fullPage:true});
async function test(id:string,fn:()=>Promise<any>){try{const data=await fn();results.push({id,passed:true,...data});console.log(JSON.stringify({id,...data}));writeFileSync(path.join(out,'results.json'),JSON.stringify(results,null,2));}catch(e){await shot('failure-'+id);results.push({id,passed:false,error:String(e)});writeFileSync(path.join(out,'results.json'),JSON.stringify(results,null,2));throw e;}}
try{
  await test('F01',async()=>{const timings=[];for(const value of ['missing','ready','error','ready']){await pause(80);const at=Date.now();await control('state',{value});await expect(page.locator('#reader-status')).toHaveAttribute('data-kind',value,{timeout:2000});timings.push({value,ms:Date.now()-at});}assert(timings.every(t=>t.ms<2000));return{timings,measures:'control POST start to DOM match; no screenshot in measured interval'};});
  await test('F02',async()=>{const seq=(await snapshot()).status.seq;for(const [kind,text] of [['blank','書き込まれていない'],['foreign','物品画面のカードではありません'],['unreadable','置き直して']]){await control('remove');await control('place',{kind});await expect(page.locator('#reader-status')).toContainText(text);await expect(page.locator('#reader-status')).toHaveAttribute('data-kind','rejected');await expect(page.locator('#item-panel')).toBeHidden();}assert.equal((await snapshot()).status.seq,seq);await shot('F02-rejection');await read('IY-100001');await expect(page.locator('#reader-status')).toHaveAttribute('data-kind','ready');await clear();return{rejection_kinds:3,successful_card_seq_delta:0,valid_card_recovers:true};});
  await test('F03-F04',async()=>{await page.route('**/api/rental/items/IY-100002',async route=>{await pause(1800);await route.continue()});const at=Date.now();await tap('IY-100002');await expect(page.locator('#lookup-status')).toContainText('No.2の情報を取得中');const loadingMs=Date.now()-at;assert(loadingMs<1000);await tap('IY-100004');await expect(page.locator('#read-notice-text')).toContainText('No.4');await expect(page.locator('#current-code')).toContainText('IY-100002');await expect(page.locator('#item-loading')).toBeHidden();await expect(page.locator('#read-notice-text')).toContainText('No.2');await expect(page.locator('#read-notice-text')).toContainText('置き直して');await shot('F03-F04-loading-blocked');await page.unroute('**/api/rental/items/IY-100002');await clear();
    await page.route('**/api/rental/items/IY-100005',route=>route.fulfill({status:503,contentType:'application/json',body:JSON.stringify({error:'検証用の一時通信エラー'})}));await tap('IY-100005');await expect(page.locator('#lookup-retry')).toBeVisible();await expect(page.locator('#lookup-status')).toContainText('No.5を開けませんでした');await shot('F03-retry');await page.unroute('**/api/rental/items/IY-100005');await page.locator('#lookup-retry').click();await expect(page.locator('#current-code')).toContainText('IY-100005');await clear();return{loading_ms:loadingMs,blocked_card_persists:true,error_retry_opens_same_code:true,no_registration:rental.item('IY-100005').status==='ready'};});
  await test('F05',async()=>{await page.setViewportSize({width:320,height:812});await read('IY-100003');const boxes=[];for(const stage of ['condition','photos','note','review']){if(stage==='photos'){await normal();await next();}if(stage==='note'){await photo();await next();}if(stage==='review')await next();await expect(page.locator('#workflow-context-item')).toContainText('No.3');await expect(page.locator('#workflow-context-action')).toContainText('貸出');await expect(page.locator('#workflow-context-action')).toContainText(group.name);const b=await page.locator('#workflow-context').boundingBox();assert(b&&b.y>=0&&b.y+b.height<=812);boxes.push({stage,...b});await shot('F05-'+stage);}assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth>innerWidth),false);await clear();await page.setViewportSize({width:1280,height:950});return{viewport:[320,812],boxes,overflow:false};});
  await test('F06',async()=>{await read('IY-100006');let loanClicks=0;await normal();loanClicks++;await expect(page.locator('#workflow-skip')).toBeVisible();await page.locator('#workflow-skip').click();loanClicks++;await expect(page.locator('#workflow-title')).toContainText('内容を確認');assert.equal(rental.item('IY-100006').status,'ready');await shot('F06-final-confirmation');await next();loanClicks++;await until(()=>rental.item('IY-100006').status==='loaned','loan');await clear();await pause(1600);await read('IY-100006');let returnClicks=0;await page.locator('[data-choice="return"]').click();returnClicks++;await normal();returnClicks++;await page.locator('#workflow-skip').click();returnClicks++;assert.equal(rental.item('IY-100006').status,'loaned');await next();returnClicks++;await until(()=>rental.item('IY-100006').status==='ready','return');await clear();
    await read('IY-100007');await normal();await expect(page.locator('#workflow-skip')).toBeHidden();await next();await next();await expect(page.locator('#message')).toContainText('1枚以上');await clear();
    await read('IY-100009');await page.locator('[data-damage="damage"]').click();await expect(page.locator('#workflow-skip')).toBeHidden();await next();await next();await next();await expect(page.locator('#message')).toContainText('メモ');await clear();
    await read('IY-100010');await normal();await next();await photo();await page.locator('#workflow-back').click();await expect(page.locator('#workflow-skip')).toBeHidden();await clear();
    await read('IY-100011');await normal();await next();await next();await page.locator('#note').fill('保持する任意メモ');await page.locator('#workflow-back').click();await page.locator('#workflow-back').click();await expect(page.locator('#workflow-skip')).toBeHidden();await clear();return{loan_button_clicks:loanClicks,return_button_clicks:returnClicks,preassigned:true,normal_internal:true,registration_requires_confirmation:true,skip_prohibited:['external-photo','damage-note','existing-photo','existing-note']};});
  await test('F07',async()=>{const notes=[];for(const [i,oldDamage,newDamage] of [[12,true,true],[13,false,true],[14,false,false]] as const){const item=rental.item('IY-'+(100000+i));await rental.submit({operation_id:crypto.randomUUID(),item_code:item.code,item_version:item.version,action:'borrow',borrower:group.name,condition:oldDamage?'damage':'normal',note:oldDamage?'脚の傷（貸出前）':'',client_at:new Date().toISOString(),client_read_at:new Date().toISOString()},[],actor);await read(item.code);await page.locator('[data-choice="return"]').click();await expect(page.locator('#condition-hint')).toContainText('貸出時からの傷だけでも');await page.locator(`[data-damage="${newDamage?'damage':'normal'}"]`).click();await next();await next();if(oldDamage){await page.locator('#existing-damage-note').click();await expect(page.locator('#note')).toHaveValue('貸出時からの傷・変化なし');}else if(newDamage)await page.locator('#note').fill('新しい傷：脚の先端');await next();await next();await until(()=>rental.item(item.code).status===(newDamage?'review':'ready'),'return result');notes.push({code:item.code,oldDamage,newDamage,latest:rental.inspection(item.code).latest});await clear();}await shot('F07-complete');return{cases:notes};});
  await test('F08',async()=>{await read('IY-100015');await normal();await next();await next();await page.locator('#note').fill('未送信で保持するメモ');await next();await page.route('**/api/rental/operations',route=>route.abort());await next();await expect(page.locator('#completion-status')).toContainText('端末に保持');const before=await page.evaluate('state.queue.find(o=>o.meta.item_code==="IY-100015").id');await page.reload();await expect(page.locator('#resume-notice')).toBeVisible();await expect(page.locator('#resume-text')).toContainText('1件');await page.locator('#resume-queue').click();assert.equal(await page.evaluate(()=>document.activeElement?.id),'queue-title');await shot('F08-resume');await page.unroute('**/api/rental/operations');await page.locator('#resend').click();await until(()=>rental.item('IY-100015').status==='loaned','resend');await expect(page.locator('#resume-notice')).toBeHidden();await page.locator('#resend').click();const ops=await page.evaluate('state.queue.filter(o=>o.meta.item_code==="IY-100015").map(o=>({id:o.id,note:o.meta.note,ack:o.acknowledged}))');assert.equal(ops.length,1);assert.equal(ops[0].id,before);assert.equal(ops[0].note,'未送信で保持するメモ');return{same_operation_id:true,client_operations:ops};});
  assert.deepEqual(errors,[]);assert.deepEqual(external,[]);
  writeFileSync(path.join(out,'summary.json'),JSON.stringify({date_jst:'2026-10-15',results,browser_errors:errors,external_requests:external,syntheticLedger:true},null,2));console.log(JSON.stringify({passed:results.length,errors,external}));
}finally{await browser.close();emu.kill();await app.close();writeFileSync(path.join(out,'emulator-output.log'),trace);}

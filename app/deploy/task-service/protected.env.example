# Committee task service, protected integration mode - TEMPLATE ONLY.
# Neutral placeholders: replace every <...> value; keep real files outside the repository.
# Key files: >= 32 random bytes, hex or base64, readable only by the service account (mode 600).
#
# Transport: the svc-auth/v1 signature protects REQUESTS (tampering, impersonation, replay) only.
# It is not encryption, and RESPONSES (task contents) are neither encrypted nor signed.
# Both callers - the common Web gateway AND the Discord bridge - must therefore use either
#   (default) same-host loopback, or
#   (explicit) an operator TLS terminator with normal certificate validation (see docs/task-service/integration-api.md).
DTM_MODE=protected
# Default: loopback only (127.0.0.1 or ::1). Gateway and Discord bridge run on this same host.
HOST=127.0.0.1
PORT=<port>
DTM_DATA_FILE=<path>/task-state.json
# Loopback bind: 127.0.0.1 and/or ::1 only (single IPs; any other address is refused).
DTM_TRUSTED_CLIENT_ADDRESSES=127.0.0.1
DTM_GATEWAY_KEY_FILE=<secret store path>/task-gateway.key
# Optional Discord bridge: set both or neither.
# DTM_DISCORD_BRIDGE_KEY_FILE=<secret store path>/discord-bridge.key
# DTM_DISCORD_BINDINGS_FILE=<path>/discord-bindings.json
#
# Non-loopback alternative (only behind operator TLS termination for BOTH callers; not secret):
# HOST=<private IP literal of this host: 10/8, 172.16/12, 192.168/16 or fc00::/7>
# DTM_TRUSTED_CLIENT_ADDRESSES=<private source IP(s) of the TLS terminator only>
# DTM_NON_LOOPBACK_TRANSPORT_ACK=operator-tls-termination-for-gateway-and-discord-bridge

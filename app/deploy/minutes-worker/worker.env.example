# 議事録の処理役の設定（worker.env として置き、chmod 600）。秘密の値はここに書かない（鍵はファイルで渡す）。
# 文字起こし・要約の 2 つの service が共通で読む。MINUTES_STAGES は各 service の側で決めるので、ここには書かない。
MINUTES_APP_URL=https://app.example.org
# 要約（ホストで動く）から見た鍵の場所。文字起こし（コンテナ）は service の側で /w/minutes-worker.key を使う。
MINUTES_KEY_FILE=/srv/iyakusai-minutes-worker/minutes-worker.key
# 2026-11-02 の本番ホストでの測定（_目録/設計/議事録自動化_20261102/設計書.md §2-3）: large-v3・8 スレッドで 1 時間の会議を約 14 分。
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cpu
WHISPER_THREADS=8
# 単語ごとの確からしさ（画面の「聞き直し」が使う。2026-11-06）。0 にすると約 2 割速いが、聞き直す文を選べなくなる。
WHISPER_WORD_TIMESTAMPS=1
# 要約（タスク候補のスクリーニングと同じ Claude Code CLI・同じログイン）。
# 本番ホストの非対話シェルの PATH には claude が無いので、スクリーニングの service と同じ場所を絶対パスで書く（2026-11-02 に確認）。
CLAUDE_COMMAND=/usr/local/bin/claude
CLAUDE_CONFIG_DIR=/srv/iyakusai-minutes-worker/claude-config
CLAUDE_MODEL=opus
# 利用者の MCP サーバーを読まない（本番の CLI 2.1.227 で使えることを 2026-11-02 に確認）。
CLAUDE_EXTRA_ARGS=--strict-mcp-config
# AI の案（聞き直す文ごとに、言ったと思われる文を Claude が文脈から推す。2026-11-10）。要約の service が受け持つ。0 で止める。
MINUTES_SUGGEST=1
MINUTES_POLL_SEC=30

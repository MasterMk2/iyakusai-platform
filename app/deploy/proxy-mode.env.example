# 配置の例（動作は確かめていない）。trusted-proxy モードの説明は README.md。
# 使う場合はリポジトリの外にある運用者ローカルのディレクトリ（例: <運用者ディレクトリ>/proxy-mode.env）へ複製し、
# プレースホルダーを承認済みの値に置き換える。実ホスト名・利用者・認証情報をこのファイルに書かない。

SMM_AUTH_MODE=trusted-proxy

# コンテナ内の待ち受け。ホストへのポート公開はしない（compose に ports を書かない）。
# 0.0.0.0 は trusted-proxy モードでだけ許可される。要求は下の許可リストのソケットアドレスからだけ受け付ける。
SMM_HOST=0.0.0.0
SMM_PORT=8080

# 正規形の https オリジン（末尾スラッシュ・パスなし）。承認後に実際の公開オリジンへ置き換える。
SMM_PUBLIC_ORIGIN=https://mail.example.invalid

# 認証プロキシ（サイドカー）の固定 IP。範囲・ワイルドカード・ホスト名は起動拒否。
SMM_TRUSTED_PROXY_ADDRESSES=172.30.57.2

# 運用者ローカルの利用者対応表（deploy/user-map.example.json の形式）。読み取り専用でマウントする。
SMM_USER_MAP_FILE=/run/smm/user-map.json

# 初回（ファイルなし）だけ合成データで初期化する。既存ファイルが読めない・不正なら起動を拒否し、上書きしない。
SMM_DATA_FILE=/app/data/state.json
SMM_STATIC_DIR=/app/dist/client

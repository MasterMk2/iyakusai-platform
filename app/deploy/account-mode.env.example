# Common Web entry, account login (production composition) - TEMPLATE ONLY.
# Neutral placeholders: replace every <...> value; keep real files outside the repository.
# Secrets are referenced by file path only (each file: >= 32 random bytes, hex or base64, mode 600).
SMM_AUTH_MODE=account
SMM_HOST=<bind IP literal, e.g. 127.0.0.1>
SMM_PORT=<port>
SMM_PUBLIC_ORIGIN=https://<public host name>
SMM_TRUSTED_PROXY_ADDRESSES=<reverse proxy socket IP>[,<another single IP>]
SMM_DATA_FILE=<path>/mail-state.json
SMM_STATIC_DIR=<path>/dist/client

# Login state, audit and security material
SMM_AUTH_PEPPER_FILE=<secret store path>/auth-pepper.key
SMM_AUTH_STORE_FILE=<path>/login-store.json
SMM_AUTH_AUDIT_FILE=<path>/auth-audit.jsonl

# Identity provider: "bridge" (default) or the explicit opt-in "direct" (see the alternative block below).
# SMM_IDENTITY_PROVIDER=bridge
# Identity bridge (operator-provided; verified email <-> Discord binding, effective Group membership, Bot DM)
# https (certificate verified) or same-host loopback http://127.0.0.1:<port> only; plain http to any other address is refused.
SMM_IDENTITY_BRIDGE_URL=https://<internal identity bridge host>
SMM_IDENTITY_BRIDGE_KEY_FILE=<secret store path>/identity-bridge.key
SMM_AUTH_GROUP_ID=<stable group id>
# SMM_AUTH_ORGANIZATION_ID=<stable organization id, only if all-organization membership qualifies>
SMM_AUTH_LINK_EVIDENCE=<approved evidence: verified_roster | operator_attestation | dual_control_proof>
# SMM_AUTH_SERVICE_LABEL=<short label shown in the DM>

# --- Alternative: in-process direct providers (replaces the two SMM_IDENTITY_BRIDGE_* lines above) ---
# Google Directory READ (fixed https://admin.googleapis.com GET paths) + the identity registry file.
# No new internal bridge is needed. POSIX only: startup is refused on Windows (owner-only permissions
# cannot be enforced there). Both files: owned by the service user, 0600 or 0400, regular file, no symlink.
# APPLICATION BLOCKERS for live use (not implemented; not operator tasks):
#  1. No Directory credential lifecycle: the application never mints or refreshes the token, and any
#     existing process that keeps the file current is UNVERIFIED. An expired token denies everyone.
#  2. No ingestion of the registry from a verified existing authority (that authority and its contract
#     are UNVERIFIED). Do not write mappings by hand: the registry is to be derived from that authority.
#  3. No real Bot DM delivery, delivery-id dedup or acknowledgement. With "unavailable" on a fresh
#     deployment nobody can log in for the first time.
# Authorization is read fresh on every request; SMM_DIRECTORY_CACHE_MS was removed and is refused.
# SMM_IDENTITY_PROVIDER=direct
# SMM_AUTH_GROUP_ID=<Google group unique id (not the group email or an alias)>
# SMM_AUTH_ORGANIZATION_ID=<Google customer id, "C..." (required in direct mode)>
# SMM_DIRECTORY_TOKEN_FILE=<secret store path>/directory-access-token
# SMM_IDENTITY_REGISTRY_FILE=<path outside Git>/identity-registry.json   (format: deploy/identity-registry.example.json)
# DM transport must be explicit: "unavailable" refuses every DM (no first-time setup or reset is possible),
# or "identity-bridge" only where an existing signed DM contract peer already exists (unverified; set
# SMM_IDENTITY_BRIDGE_URL / _KEY_FILE then).
# SMM_AUTH_DM_TRANSPORT=unavailable

# Task service (internal only) and the principal -> task user map
# Same-host loopback (http://127.0.0.1:<port>) or https://<task service host> through a TLS terminator; other plain http is refused.
# The gateway signature (svc-auth/v1) protects requests only: it is not encryption, and Task responses are not signed.
# The Discord bridge must follow the same rule (see docs/task-service/integration-api.md, "通信路").
SMM_TASK_SERVICE_URL=http://127.0.0.1:<port>
SMM_TASK_GATEWAY_KEY_FILE=<secret store path>/task-gateway.key
SMM_TASK_BRIDGE_FILE=<path>/task-bridge.json
# SMM_TASK_LINK_FILE=<path>/mail-state.task-links.json

# LINE stays off unless explicitly enabled with its own data file (mock connector only).
# SMM_LINE_MODE=off
